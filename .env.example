# Pulse POS — root environment (local dev / docker-compose overrides)
# Copy to .env and adjust. Never commit real secrets.

# ── Frontend build (docker-compose build arg) ──
# Local dev: use /api/v1 (Vite proxies to backend on 8001). Docker build uses full URL in docker-compose.yml.
VITE_API_URL=/api/v1

# ── Node server (production container) ──
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ── PostgreSQL (docker-compose) ──
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=pulse_pos

# ── Backend (passed to backend service) ──
SECRET_KEY=dev-secret-change-in-production-min-32-chars!!
JWT_REFRESH_SECRET_KEY=
DATABASE_URL=postgresql+psycopg2://pulse:change-me-local-only@postgres:5432/pulse_pos
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://pulse-pos:3000
ENVIRONMENT=development
LOG_LEVEL=info
SEED_ON_STARTUP=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Failed logins are counted per (email, source IP) so one attacker cannot lock a
# real cashier out of the till. This is the all-IP ceiling that still stops
# distributed password spraying.
LOGIN_GLOBAL_MAX_ATTEMPTS=50
# Whose X-Forwarded-For we believe. "private" = loopback + RFC1918 + unique-local
# (normal nginx/Docker setup), "none" = ignore the header, or a CSV of CIDRs.
# Never widen this to include untrusted networks: it controls both rate-limit
# bucketing and the IP recorded in the audit log.
TRUSTED_PROXIES=private
BACKUP_PATH=./backups
STORAGE_PATH=./storage

# ── Compose port overrides (optional) ──
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# ── Referral & Commission Platform Integration ──
REFERRAL_ENABLED=true
REFERRAL_PLATFORM_URL=http://localhost:8000
REFERRAL_PRODUCT_KEY_ID=key_pulsepos_test
REFERRAL_PRODUCT_SECRET=sec_pulsepos_test
REFERRAL_SIGNING_SECRET=sig_pulsepos_test
REFERRAL_PORTAL_URL=http://localhost:3000
