# Pulse POS — Production Environment Template
# Copy this file to .env, fill in ALL values, and keep it out of version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend ─────────────────────────────────────────────────────────────────
# Public API URL baked into the frontend at build time (used by VITE_API_URL)
VITE_API_URL=https://api.yourdomain.com/api/v1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=pulse
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD   # openssl rand -hex 24
POSTGRES_DB=pulse_pos

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD   # openssl rand -hex 16

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Both MUST be different and 32+ characters. Server refuses to start if not set.
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET_KEY=REPLACE_WITH_DIFFERENT_OPENSSL_RAND_HEX_32

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://pulse:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/pulse_pos
CORS_ORIGINS=https://app.yourdomain.com
ENVIRONMENT=production
LOG_LEVEL=warning

# Authentication settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
# Lockout counters are per (email, source IP), so a single attacker can only
# lock themselves out — not a cashier mid-shift. This all-IP ceiling still
# catches distributed password spraying against one account.
LOGIN_GLOBAL_MAX_ATTEMPTS=50

# Reverse proxies whose X-Forwarded-For header is trusted. This governs both
# login rate-limit bucketing and the client IP written to the audit log, so it
# must list only proxies you operate. "private" covers the bundled nginx on the
# Docker network; replace with explicit CIDRs when running behind a cloud LB.
TRUSTED_PROXIES=private

# Disable demo/dev features
SEED_ON_STARTUP=false
ALLOW_PUBLIC_ONBOARDING=false

# Rate limiting (must use Redis in production)
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUIRE_REDIS=true

# Caching
CACHE_BACKEND=redis
CACHE_TTL_SECONDS=60

# Storage paths inside the backend container
BACKUP_PATH=/var/backups/pulse
STORAGE_PATH=/var/lib/pulse/storage

# ── Backups ───────────────────────────────────────────────────────────────────
# Passphrase for GPG-symmetric encryption of the daily db-backup dumps at rest.
BACKUP_ENCRYPTION_PASSPHRASE=REPLACE_WITH_OPENSSL_RAND_HEX_32   # openssl rand -hex 32

# ── Monitoring ────────────────────────────────────────────────────────────────
# Grafana is bound to 127.0.0.1 only (see docker-compose.prod.yml) — reach it via
# an SSH tunnel or put it behind nginx/a VPN; it is not exposed to the internet.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_ADMIN_PASSWORD
GRAFANA_ROOT_URL=https://grafana.yourdomain.com
GRAFANA_PORT=3001

# ── Nginx ────────────────────────────────────────────────────────────────────
# NOTE: nginx.conf is bind-mounted as-is (no envsubst templating wired up), so
# this value is NOT read automatically — edit `server_name` in nginx/nginx.conf
# directly at deploy time. Kept here for documentation/consistency only.
NGINX_SERVER_NAME=app.yourdomain.com
