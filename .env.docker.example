# Pulse POS — Docker Compose development stack
# Copy to .env in repo root before: docker compose up --build

VITE_API_URL=http://localhost:8000/api/v1

POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse_pos

SECRET_KEY=dev-secret-change-in-production-min-32-chars!!
JWT_REFRESH_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://pulse-pos:3000
ENVIRONMENT=development
LOG_LEVEL=info
SEED_ON_STARTUP=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BACKUP_PATH=./backups
STORAGE_PATH=./storage

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
