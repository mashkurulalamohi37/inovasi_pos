# Pulse POS backend — environment variables
# Copy to backend/.env for local development

DATABASE_URL=postgresql+psycopg2://pulse:pulse@localhost:5540/pulse_pos
# Docker maps Postgres to host port 5540 (see docker-compose.yml) to avoid
# local Windows PostgreSQL on 5432 and Hyper-V excluded range 5433-5532.
# SQLite fallback for quick local dev without Docker:
# DATABASE_URL=sqlite:///./pulse_local.db

SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_REFRESH_SECRET_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
LOG_LEVEL=info
SEED_ON_STARTUP=true
ALLOW_PUBLIC_ONBOARDING=true

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_GLOBAL_MAX_ATTEMPTS=50
TRUSTED_PROXIES=private

# Redis (docker compose redis service on 6379)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true
CACHE_BACKEND=redis
CACHE_TTL_SECONDS=60

# Sized for many tills + background sync against one backend. 5 + 10 was
# saturated by a modest burst, and callers blocked 30s before failing.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Seconds to wait for a free connection before returning a retryable 503.
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=3600

BACKUP_PATH=./backups
STORAGE_PATH=./storage

# Referral & Commission Platform Integration
REFERRAL_ENABLED=true
REFERRAL_PLATFORM_URL=http://118.179.223.42:8085
REFERRAL_PRODUCT_SLUG=pulsepos
REFERRAL_PRODUCT_KEY_ID=key_pulsepos_test
REFERRAL_PRODUCT_SECRET=sec_pulsepos_test
REFERRAL_SIGNING_SECRET=sig_pulsepos_test
REFERRAL_PORTAL_URL=http://118.179.223.42:8085
