{
  "name": "inovasi-pos",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "node .output/server/index.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "backend:dev": "cd backend && python -m uvicorn app.main:app --reload --port 9200",
    "backend:init": "cd backend && python -m app.manage migrate && python -m app.manage seed",
    "backend:migrate": "cd backend && python -m app.manage migrate",
    "backend:readiness": "cd backend && python -m app.manage readiness",
    "backend:migrate:docker": "docker compose exec backend python -m app.manage migrate",
    "backend:migrate:down": "cd backend && python -m app.manage migrate-down",
    "backend:seed": "cd backend && python -m app.manage seed",
    "backend:seed:docker": "docker compose exec backend python -m app.manage seed",
    "backend:reset-demo": "cd backend && python -m app.manage reset-demo",
    "backend:create-super-admin": "cd backend && python -m app.manage create-super-admin",
    "backend:create-tenant-user": "cd backend && python -m app.manage create-tenant-user",
    "backend:disable-demo-users": "cd backend && python -m app.manage disable-demo-users",
    "backend:wait-db": "cd backend && python -m app.manage wait-db",
    "backend:cleanup-tokens": "cd backend && python -m app.manage cleanup-tokens",
    "backend:cleanup-tokens:docker": "docker compose exec backend python -m app.manage cleanup-tokens",
    "perf:smoke": "python scripts/perf_smoke_test.py",
    "docker:smoke": "python scripts/docker_smoke_test.py",
    "uat:cycle2": "python scripts/uat_cycle2_smoke.py",
    "prod:check": "python scripts/prod_readiness_check.py",
    "go-live:check": "cd backend && python -m pytest tests/test_go_live_hardening.py -v --tb=short",
    "live:trial": "python scripts/live_trial_smoke.py",
    "backup:db": "sh scripts/backup_postgres.sh",
    "backend:test": "cd backend && python -m pytest tests/ -v",
    "backend:test:postgres": "cd backend && python -m pytest tests_postgres/ -v -m postgres",
    "backend:test:upgrade-matrix": "cd backend && python scripts/pg_upgrade_matrix.py",
    "frontend:test": "vitest run",
    "frontend:test:watch": "vitest",
    "test:all": "npm run backend:test && npm run frontend:test",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep \"@smoke\"",
    "e2e:ui": "playwright test --grep \"@ui\"",
    "e2e:install": "playwright install chromium",
    "load:smoke": "python scripts/load/measured_load.py --vus 3 --iterations 10",
    "load:k6": "k6 run scripts/load/k6_smoke.js",
    "backup:restore-drill": "python scripts/backup_restore_drill.py",
    "backup:offhost-drill": "python scripts/backup_offhost_drill.py",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
