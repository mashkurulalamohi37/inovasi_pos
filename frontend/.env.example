# Pulse POS frontend — environment variables
# Copy to .env in repo root (Vite reads from project root)

# Backend API base URL (required for authenticated / Live mode)
VITE_API_URL=http://localhost:8000/api/v1

# Dev server (optional)
# HOST=0.0.0.0
# PORT=3000

# Note: VITE_* variables are embedded at build time.
# For Docker production builds, set VITE_API_URL as a docker-compose build arg.
